<svg xmlns="http://www.w3.org/2000/svg" class="sprite" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
<defs>
<linearGradient id="tg-rose" x2=".7" y2="1"><stop stop-color="#ffe0e6"/><stop offset=".45" stop-color="#e98d9d"/><stop offset="1" stop-color="#7d3345"/></linearGradient>
<linearGradient id="tg-glass" x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#f1ecff" stop-opacity=".95"/><stop offset=".45" stop-color="#9d8fd6" stop-opacity=".75"/><stop offset="1" stop-color="#3b3160" stop-opacity=".95"/></linearGradient>
</defs>
<!-- U3 · Nap (mezo-me75u.3) — új 3D ikonok, a bible §4 receptje szerint -->
<!-- Check-in: egy pillanatkép-mérő (számlap, rózsaszín mutató) -->
<symbol id="t-checkin" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><circle cx="32" cy="34" r="24" fill="url(#tg-titanium)" stroke="#e9e4f6" stroke-width=".8"/><circle cx="32" cy="34" r="18" fill="#221e2c" stroke="#8e8a9e" stroke-width=".6"/><path d="M17 40A15.5 15.5 0 0 1 47 40" fill="none" stroke="url(#tg-rose)" stroke-width="4" stroke-linecap="round"/><g stroke="#e9e4f6" stroke-width="1.4" stroke-linecap="round" opacity=".7"><path d="M19 30l2 1"/><path d="M32 22v2.4"/><path d="M45 30l-2 1"/></g><path d="M32 37L41 27" stroke="url(#tg-rose)" stroke-width="3.2" stroke-linecap="round"/><circle cx="32" cy="37" r="3.6" fill="url(#tg-gold)" stroke="#fff3d6" stroke-width=".6"/><path d="M15 25C17 20 21 16 26 14" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".75"/></g></symbol>
<!-- Emberek / Kapcsolat: két alak -->
<symbol id="t-people" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><circle cx="42" cy="21" r="8" fill="url(#tg-purple)" stroke="#eee0ff" stroke-width=".7"/><path d="M28 50C28 38 34 32 42 32S56 38 56 50C56 53 54 54 51 54H33C30 54 28 53 28 50Z" fill="url(#tg-purple)" stroke="#eee0ff" stroke-width=".7"/><circle cx="23" cy="23" r="9" fill="url(#tg-rose)" stroke="#ffe0e6" stroke-width=".8"/><path d="M7 52C7 40 14 34 23 34S39 40 39 52C39 55 37 57 34 57H12C9 57 7 55 7 52Z" fill="url(#tg-rose)" stroke="#ffe0e6" stroke-width=".8"/><path d="M18 18C19 16 21 15 23 15" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/><path d="M12 46C13 42 15 39 18 38" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".7"/></g></symbol>
<!-- Rutin / lánc: két összefűzött arany láncszem -->
<symbol id="t-chain" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><rect x="6" y="20" width="30" height="20" rx="10" transform="rotate(-35 21 30)" fill="none" stroke="url(#tg-gold)" stroke-width="7"/><rect x="28" y="24" width="30" height="20" rx="10" transform="rotate(-35 43 34)" fill="none" stroke="url(#tg-titanium)" stroke-width="7"/><path d="M29 22.5L33 28" stroke="url(#tg-gold)" stroke-width="7" stroke-linecap="round"/><path d="M12 30C12 26 14 23 17 21" fill="none" stroke="#fff3d6" stroke-width="1.8" stroke-linecap="round" opacity=".85"/><path d="M36 39C37 36 39 33 42 31" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".7"/></g></symbol>
<!-- Küldetés: zászló a rúdon -->
<symbol id="t-quest" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><ellipse cx="22" cy="56" rx="12" ry="3.5" fill="url(#tg-titanium)" opacity=".9"/><rect x="18.5" y="7" width="5" height="50" rx="2.5" fill="url(#tg-titanium)" stroke="#e9e4f6" stroke-width=".6"/><circle cx="21" cy="7" r="4" fill="url(#tg-gold)" stroke="#fff3d6" stroke-width=".6"/><path d="M23.5 12C31 9 36 15 44 13C48 12 52 10 55 9V32C52 33 48 35 44 36C36 38 31 32 23.5 35Z" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".8"/><path d="M36 19l2 4.2 4.6.6-3.4 3.2.9 4.5-4.1-2.3-4.1 2.3.9-4.5-3.4-3.2 4.6-.6Z" fill="#fff3d6" opacity=".9"/><path d="M27 16C30 15 32 16 34 17" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".8"/></g></symbol>
<!-- Érme -->
<symbol id="t-coin" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><ellipse cx="32" cy="36" rx="22" ry="21" fill="#604831"/><circle cx="32" cy="32" r="22" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".9"/><circle cx="32" cy="32" r="16" fill="none" stroke="#fff3d6" stroke-width="1.4" opacity=".6"/><path d="M32 21l3 7.5 8 .4-6.2 5 2.1 7.7L32 37.2l-6.9 4.4 2.1-7.7-6.2-5 8-.4Z" fill="#fff3d6" opacity=".9"/><path d="M16 26C17 20 21 16 26 14" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".8"/></g></symbol>
<!-- A mai termés: kalászköteg -->
<symbol id="t-harvest" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><path d="M27 34L22 58H42L37 34Z" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".7"/><g stroke="#604831" stroke-width=".8" opacity=".6"><path d="M29 38L26 57"/><path d="M32 38V57"/><path d="M35 38L38 57"/></g><g fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".7"><path d="M32 4C37 9 37 22 32 30C27 22 27 9 32 4Z"/><path d="M17 10C23 12 27 23 26 32C19 28 14 17 17 10Z"/><path d="M47 10C41 12 37 23 38 32C45 28 50 17 47 10Z"/><path d="M8 22C14 22 21 29 23 35C16 35 9 29 8 22Z"/><path d="M56 22C50 22 43 29 41 35C48 35 55 29 56 22Z"/></g><g stroke="#fff3d6" stroke-width="1" fill="none" opacity=".7"><path d="M29 12L32 15L35 12M29 18L32 21L35 18M29 24L32 27L35 24"/></g><rect x="24" y="39" width="16" height="5" rx="2" fill="url(#tg-red)" stroke="#ffd2c2" stroke-width=".6"/><path d="M30 9C30.5 7 31 6 32 5.5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"/></g></symbol>
<!-- Kísérlet: lombik -->
<symbol id="t-flask" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><path d="M25 8H39V24L53 50C55 54 52 58 48 58H16C12 58 9 54 11 50L25 24Z" fill="url(#tg-glass)" stroke="#eee0ff" stroke-width=".8"/><path d="M17 42H47L52 51C53 54 51 56 48 56H16C13 56 11 54 12 51Z" fill="url(#tg-lime)" stroke="#eeffb9" stroke-width=".6"/><rect x="22" y="5" width="20" height="6" rx="3" fill="url(#tg-titanium)" stroke="#e9e4f6" stroke-width=".6"/><circle cx="28" cy="48" r="2.2" fill="#eeffb9" opacity=".8"/><circle cx="37" cy="50" r="1.6" fill="#eeffb9" opacity=".7"/><circle cx="33" cy="36" r="1.8" fill="#eee0ff" opacity=".6"/><path d="M28 14V25L20 40" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".7"/></g></symbol>
<!-- Jóslat: kristálygömb talpon -->
<symbol id="t-orb" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><path d="M16 50H48L52 58H12Z" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".7"/><circle cx="32" cy="29" r="21" fill="url(#tg-purple)" stroke="#eee0ff" stroke-width=".8"/><circle cx="32" cy="29" r="21" fill="url(#tg-blue)" opacity=".25"/><path d="M26 30c2-6 10-6 12 0-2 4-10 4-12 0Z" fill="#fff" opacity=".35"/><circle cx="38" cy="22" r="1.4" fill="#fff" opacity=".8"/><circle cx="26" cy="36" r="1" fill="#fff" opacity=".7"/><path d="M18 22C20 16 25 12 31 11" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".8"/></g></symbol>
<!-- Összegzés / memoár: tekercs -->
<symbol id="t-scroll" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><path d="M16 10H46C50 10 52 13 52 16V50H22C18 50 16 47 16 44Z" fill="url(#tg-titanium)" stroke="#e9e4f6" stroke-width=".8"/><rect x="10" y="7" width="12" height="10" rx="5" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".6"/><path d="M22 50C18 50 16 53 16 55S18 59 22 59H54C50 59 49 56 49 55S50 50 52 50Z" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".6"/><g stroke="#e9e4f6" stroke-width="2" stroke-linecap="round" opacity=".75"><path d="M26 22H44"/><path d="M26 29H44"/><path d="M26 36H38"/></g><path d="M20 20V40" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".55"/></g></symbol>
<!-- Aktivitás: két lábnyom -->
<symbol id="t-steps" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><g transform="rotate(-14 20 32)"><path d="M13 30C12 22 15 16 20 16S28 22 27 30C26 37 25 44 20 44S14 37 13 30Z" fill="url(#tg-rose)" stroke="#ffe0e6" stroke-width=".7"/><g fill="url(#tg-rose)" stroke="#ffe0e6" stroke-width=".5"><circle cx="13.5" cy="11" r="2.6"/><circle cx="18" cy="8.4" r="2.4"/><circle cx="22.4" cy="8.6" r="2.2"/><circle cx="26" cy="10.6" r="2"/><circle cx="28.4" cy="13.8" r="1.7"/></g><path d="M16 24C16 21 18 19 20 19" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".8"/></g><g transform="rotate(12 44 40)"><path d="M37 44C36 36 39 30 44 30S52 36 51 44C50 51 49 58 44 58S38 51 37 44Z" fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".7"/><g fill="url(#tg-gold)" stroke="#ffebbe" stroke-width=".5"><circle cx="37.5" cy="25" r="2.6"/><circle cx="42" cy="22.4" r="2.4"/><circle cx="46.4" cy="22.6" r="2.2"/><circle cx="50" cy="24.6" r="2"/><circle cx="52.4" cy="27.8" r="1.7"/></g><path d="M40 38C40 35 42 33 44 33" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".8"/></g></g></symbol>
<!-- Gyors logolás: világító plusz-gömb -->
<symbol id="t-quick" viewBox="0 0 64 64"><g filter="url(#tg-shadow)"><circle cx="32" cy="32" r="24" fill="url(#tg-purple)" stroke="#eee0ff" stroke-width=".8"/><circle cx="32" cy="32" r="17" fill="#2a2440" opacity=".55"/><path d="M32 21V43M21 32H43" stroke="url(#tg-gold)" stroke-width="6" stroke-linecap="round"/><path d="M32 22.5V41.5M22.5 32H41.5" stroke="#fff3d6" stroke-width="1.6" stroke-linecap="round" opacity=".7"/><path d="M14 26C16 19 21 14 28 12" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".8"/></g></symbol>
</svg>
